# --- LLM + embeddings ------------------------------------------------------
# Default provider: an Azure OpenAI (Azure AI Foundry) resource, through its
# OpenAI-compatible v1 endpoint. Chat and embeddings both use it.
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# Any other LangChain provider works too (init_chat_model / init_embeddings),
# using that provider's own env vars (OPENAI_API_KEY, ANTHROPIC_API_KEY, ...):
# TABLETALK_LLM_PROVIDER=openai          # openai | anthropic | ollama | google_genai | ...
# TABLETALK_LLM_MODEL=gpt-5.4
# TABLETALK_EMBEDDING_PROVIDER=openai
# TABLETALK_EMBEDDING_MODEL=text-embedding-3-small

# --- Target database -------------------------------------------------------
# Defaults to data/demo.db (build it with: python scripts/build_demo_db.py).
# Either a SQLite file path or any SQLAlchemy URL. Install the driver package,
# and use a READ-ONLY login for server databases:
# TABLETALK_DB=C:\path\to\your.db
# TABLETALK_DB=postgresql+psycopg://readonly:pass@host:5432/dbname
# TABLETALK_DB=mysql+pymysql://readonly:pass@host:3306/dbname
# TABLETALK_DB=mssql+pyodbc://readonly:pass@host/dbname?driver=ODBC+Driver+18+for+SQL+Server
# TABLETALK_DB=snowflake://user:pass@account/db/schema?warehouse=wh&role=readonly

# --- Answer quality knobs (optional) ---------------------------------------
# Reasoning effort per role (minimal | low | medium | high; empty = don't send).
# TABLETALK_EFFORT_FAST=minimal      # rung 1: fixed pipeline write_sql / answer / verify
# TABLETALK_EFFORT_RETRY=high        # rung 2: second attempt after an unreliable result
# TABLETALK_EFFORT_AGENT=medium      # rung 3: tool-calling agent
# TABLETALK_SELF_CHECK=1             # add the `verify` node (one cheap LLM call per answer)
# TABLETALK_FULL_SCHEMA=1            # inline every schema card instead of top-k retrieval
# TABLETALK_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L12-v2   # any HF repo with onnx/model.onnx
# TABLETALK_AUTO_LEARN=1             # save reliable question->SQL runs to the feed as "auto" examples
